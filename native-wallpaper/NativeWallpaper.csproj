<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationIcon>../server/assets/LyricServer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <InternalsVisibleTo Include="NativeWallpaper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <EmbeddedResource Include="Rendering/Glass.hlsl" LogicalName="Glass.hlsl" />
    <EmbeddedResource Include="Rendering/SettingsGlass.hlsl" LogicalName="SettingsGlass.hlsl" />
    <EmbeddedResource Include="../LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="../THIRD_PARTY_NOTICES.md" LogicalName="THIRD_PARTY_NOTICES.md" />
  </ItemGroup>
</Project>
