<fluent:FluentWindow x:Class="LyricWallpaper.Presentation.ColorPickerWindow" x:ClassModifier="internal"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:local="clr-namespace:LyricWallpaper.Presentation"
                     Width="358" MinWidth="0" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                     ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                     ExtendsContentIntoTitleBar="True" UseLayoutRounding="True"
                     Background="{DynamicResource ApplicationBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <fluent:FluentWindow.Resources>
        <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0000" Offset="0" />
            <GradientStop Color="#FFFF00" Offset="0.166667" />
            <GradientStop Color="#00FF00" Offset="0.333333" />
            <GradientStop Color="#00FFFF" Offset="0.5" />
            <GradientStop Color="#0000FF" Offset="0.666667" />
            <GradientStop Color="#FF00FF" Offset="0.833333" />
            <GradientStop Color="#FF0000" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ColorSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="9" Margin="8,0" CornerRadius="4.5"
                                    Background="{DynamicResource ColorCheckerBrush}" />
                            <Border Height="9" Margin="8,0" CornerRadius="4.5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#70253140" StrokeThickness="1.2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </fluent:FluentWindow.Resources>
    <DockPanel>
        <fluent:TitleBar x:Name="PickerTitle" DockPanel.Dock="Top" Height="38"
                         ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="18,8,18,16">
            <StackPanel x:Name="ColorControls">
                <Border x:Name="ColorPlane" Height="140" CornerRadius="9" Focusable="True" Cursor="Cross"
                        FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                        AutomationProperties.Name="饱和度与明度"
                        AutomationProperties.HelpText="左右调整饱和度，上下调整明度">
                    <Grid>
                        <Border CornerRadius="9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="9" BorderBrush="#14000000" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Grid x:Name="Marker" Width="16" Height="16">
                                <Ellipse Stroke="#D9212A36" StrokeThickness="1.2" />
                                <Ellipse Margin="1.3" Stroke="White" StrokeThickness="1.5" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>
                <Slider x:Name="HueSlider" Style="{StaticResource ColorSlider}" Margin="0,9,0,8"
                        Background="{StaticResource HueGradient}" Minimum="0" Maximum="360"
                        SmallChange="1" LargeChange="15" AutomationProperties.Name="色相" />
            </StackPanel>
            <TextBlock x:Name="ColorLockNote" Visibility="Collapsed"
                       Margin="0,2,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <DockPanel Margin="0,0,0,2">
                <fluent:TextBox x:Name="OpacityInput" DockPanel.Dock="Right" Width="72" Height="28"
                                Padding="4,0" FontFamily="Cascadia Mono, Consolas"
                                TextAlignment="Center" VerticalContentAlignment="Center"
                                AutomationProperties.Name="不透明度百分比" />
                <TextBlock Text="不透明度" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
            <Slider x:Name="OpacitySlider" Style="{StaticResource ColorSlider}"
                    TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"
                    AutomationProperties.Name="不透明度" />
            <DockPanel Margin="0,13,0,0" LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6"
                        Background="{DynamicResource ColorCheckerBrush}" Margin="0,0,7,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border x:Name="PreviewSwatch" CornerRadius="5" />
                </Border>
                <fluent:TextBox x:Name="HexInput" DockPanel.Dock="Left" Width="93" Height="32"
                                Padding="5,0" FontFamily="Cascadia Mono, Consolas"
                                TextAlignment="Center" VerticalContentAlignment="Center"
                                AutomationProperties.Name="HEX 颜色" ToolTip="输入六位 HEX 颜色，例如 #B8EBFF" />
                <local:NativeGlassButton x:Name="ApplyButton" DockPanel.Dock="Right" Content="应用"
                                         Style="{DynamicResource NativeAction}" IsAccent="True" IsDefault="True" Click="Apply" />
                <local:NativeGlassButton DockPanel.Dock="Right" Content="取消"
                                         Style="{DynamicResource NativeAction}" Margin="0,0,7,0" IsCancel="True" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</fluent:FluentWindow>
