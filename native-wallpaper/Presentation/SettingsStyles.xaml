<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml">
    <DrawingBrush x:Key="ColorCheckerBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute"
                  Viewbox="0,0,10,10" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FCFDFE" Geometry="M0,0 H10 V10 H0 Z" />
                <GeometryDrawing Brush="#DCE2E9" Geometry="M0,0 H5 V5 H0 Z M5,5 H10 V10 H5 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="SettingsListItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="12,4,8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="HoverBackground" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="6" IsHitTestVisible="False" Opacity="0" />
                        <Border x:Name="NavigationBackground" Background="Transparent"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Border x:Name="SelectionIndicator" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="1,0,0,0" Width="3" Height="16" CornerRadius="1.5"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SystemAccentColorPrimary}" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavigationBackground" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="HoverBackground" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="MinWidth" Value="196" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <fluent:EffectThicknessDecorator Thickness="12">
                        <Border x:Name="MenuSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.17" BlurRadius="12" ShadowDepth="3" Direction="270" />
                            </Border.Effect>
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </fluent:EffectThicknessDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuRow" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="9,0,10,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <fluent:SymbolIcon x:Name="Checkmark" Grid.Column="2" Symbol="Checkmark16" FontSize="14"
                                               Foreground="{DynamicResource SliderThumbBackground}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetRemoveStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" Background="#F6F8FB" BorderBrush="#D5DCE4" BorderThickness="1"
                            CornerRadius="20" SnapsToDevicePixels="True">
                        <fluent:SymbolIcon Symbol="Dismiss16" FontSize="14" Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="#FBE8E7" />
                            <Setter Property="Foreground" Value="#9F3029" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="#F4D7D5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="#0067C0" />
                            <Setter TargetName="Circle" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetColorSwatchStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="23" />
        <Setter Property="Height" Value="23" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" BorderBrush="#D5DCE4" BorderThickness="1" CornerRadius="5"
                            Background="Transparent" Padding="2" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="#E4F0FC" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#0067C0" />
                            <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Ring" Property="Padding" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#0067C0" />
                            <Setter TargetName="Ring" Property="Background" Value="#E4F0FC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
